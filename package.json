{
  "name": "picorer",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A minimal, source-grounded memory agent runtime built on Pi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fendss/picorer.git"
  },
  "homepage": "https://github.com/fendss/picorer#readme",
  "bugs": {
    "url": "https://github.com/fendss/picorer/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "docs:catalog": "node scripts/generate-code-catalog.mjs",
    "docs:catalog:check": "node scripts/generate-code-catalog.mjs --check",
    "release:manifests": "node scripts/generate-release-manifests.mjs",
    "release:manifests:check": "node scripts/generate-release-manifests.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python:memoryagentbench": "python3 -B -m unittest discover -s integrations/memoryagentbench/tests -p 'test_*.py'",
    "test:python:memoryarena-public": "python3 -B -m unittest discover -s integrations/memoryarena-public/tests -p 'test_*.py'",
    "test:python": "python3 -m unittest scripts/test_longmemeval_frozen_eval.py scripts/test_tau_knowledge_provider_health.py scripts/test_tau_knowledge_result_integrity.py && npm run test:python:memoryagentbench && npm run test:python:memoryarena-public && python3 -m py_compile integrations/tau-knowledge/picorer_tau_agent.py integrations/tau-knowledge/provider_health.py integrations/tau-knowledge/result_integrity.py integrations/tau-knowledge/run_tau_knowledge.py integrations/memoryarena-public/bootstrap.py && python3 -m compileall -q integrations/memoryagentbench integrations/memoryarena-public/runtime integrations/memoryarena-public/upstream",
    "check": "npm run docs:catalog:check && npm run typecheck && npm test -- --maxWorkers=4 && npm run test:python && npm run build",
    "cli": "node --disable-warning=ExperimentalWarning dist/cli.js",
    "serve:ldbd": "node --disable-warning=ExperimentalWarning dist/entrypoints/ldbd-api/main.js",
    "serve:memoryarena-public": "node --disable-warning=ExperimentalWarning dist/memoryarena-public-api.js",
    "memoryarena-public:bootstrap": "python3 integrations/memoryarena-public/bootstrap.py",
    "memoryarena-public:hydrate": "PYTHONPATH=integrations/memoryarena-public python3 -m upstream.hydrate",
    "memoryarena-public:assets": "PYTHONPATH=integrations/memoryarena-public python3 -m upstream.assets",
    "memoryarena-public:manifest": "PYTHONPATH=integrations/memoryarena-public python3 -m upstream.manifest",
    "memoryarena-public:prepare": "PYTHONPATH=integrations/memoryarena-public python3 -m upstream.prepare",
    "memoryarena-public:run": "python3 integrations/memoryarena-public/runtime/run_memoryarena_public.py",
    "memoryarena-public:evaluate": "PYTHONPATH=integrations/memoryarena-public python3 -m upstream.evaluator"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "typebox": "1.3.8",
    "undici": "7.29.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
